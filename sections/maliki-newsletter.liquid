<section class="mk-section mk-newsletter" dir="{{ section.settings.direction }}">
  {% if section.settings.image != blank %}
    {{ section.settings.image | image_url: width: 2200 | image_tag: widths: '750, 1400, 2200', loading: 'lazy', alt: section.settings.heading }}
  {% else %}
    <img src="{{ 'maliki-journey.png' | asset_url }}" width="1536" height="864" loading="lazy" alt="">
  {% endif %}
  <h2 class="mk-newsletter__title">{{ section.settings.heading }}</h2>
  {% if section.settings.text != blank %}<p class="mk-newsletter__copy">{{ section.settings.text }}</p>{% endif %}
  {% form 'customer', class: 'mk-newsletter__form' %}
    <input type="hidden" name="contact[tags]" value="newsletter">
    <label class="visually-hidden" for="NewsletterEmail-{{ section.id }}">{{ section.settings.placeholder }}</label>
    <input id="NewsletterEmail-{{ section.id }}" type="email" name="contact[email]" value="{{ form.email }}" placeholder="{{ section.settings.placeholder }}" required autocomplete="email">
    <button type="submit">{{ section.settings.button_label }}</button>
  {% endform %}
</section>

{% schema %}
{
  "name": "Maliki newsletter",
  "tag": "section",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Background image" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Be part of our journey" },
    { "type": "text", "id": "text", "label": "Text", "default": "Subscribe for stories, new collections and special offers." },
    { "type": "text", "id": "placeholder", "label": "Email placeholder", "default": "Email address" },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Subscribe" },
    { "type": "select", "id": "direction", "label": "Text direction", "default": "ltr", "options": [
      { "value": "ltr", "label": "Left to right" },
      { "value": "rtl", "label": "Right to left" }
    ] }
  ],
  "presets": [{ "name": "Maliki newsletter" }]
}
{% endschema %}
