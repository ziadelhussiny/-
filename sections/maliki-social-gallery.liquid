<section class="mk-section mk-paper mk-social" dir="{{ section.settings.direction }}">
  <div class="mk-wrap">
    <div class="mk-section-heading"><div><p class="mk-kicker">{{ section.settings.eyebrow }}</p><h2 class="mk-section-title">{{ section.settings.heading }}</h2></div>{% if section.settings.follow_label != blank %}<a href="{{ section.settings.follow_link | default: '#' }}">{{ section.settings.follow_label }}</a>{% endif %}</div>
    <div class="mk-social-grid">
      {% for block in section.blocks %}
        <a href="{{ block.settings.link | default: '#' }}" aria-label="{{ block.settings.label }}" {{ block.shopify_attributes }}>
          {% if block.settings.image != blank %}
            {{ block.settings.image | image_url: width: 500 | image_tag: widths: '180, 300, 500', loading: 'lazy', alt: block.settings.label }}
          {% else %}
            {% case forloop.index %}
              {% when 1 %}{% assign fallback = 'maliki-catalog-seating.png' %}
              {% when 2 %}{% assign fallback = 'maliki-catalog-tent.png' %}
              {% when 3 %}{% assign fallback = 'maliki-catalog-rugs.png' %}
              {% when 4 %}{% assign fallback = 'maliki-catalog-storage.png' %}
              {% when 5 %}{% assign fallback = 'maliki-catalog-accessories.png' %}
              {% else %}{% assign fallback = 'maliki-catalog-seating.png' %}
            {% endcase %}
            <img src="{{ fallback | asset_url }}" width="1536" height="1024" loading="lazy" alt="{{ block.settings.label | escape }}">
          {% endif %}
        </a>
      {% endfor %}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Maliki social gallery",
  "tag": "section",
  "max_blocks": 12,
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "@malikarabic" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Follow us on Instagram" },
    { "type": "text", "id": "follow_label", "label": "Follow link label", "default": "Follow" },
    { "type": "url", "id": "follow_link", "label": "Follow link" },
    { "type": "select", "id": "direction", "label": "Text direction", "default": "ltr", "options": [
      { "value": "ltr", "label": "Left to right" },
      { "value": "rtl", "label": "Right to left" }
    ] }
  ],
  "blocks": [
    {
      "type": "image",
      "name": "Gallery image",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Image" },
        { "type": "text", "id": "label", "label": "Image description", "default": "Maliki on Instagram" },
        { "type": "url", "id": "link", "label": "Link" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Maliki social gallery",
      "blocks": [
        { "type": "image" }, { "type": "image" }, { "type": "image" },
        { "type": "image" }, { "type": "image" }, { "type": "image" }
      ]
    }
  ]
}
{% endschema %}
