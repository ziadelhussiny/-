<section class="mk-section mk-paper mk-showroom" dir="{{ section.settings.direction }}">
  <div class="mk-showroom__grid">
    <div class="mk-showroom__content">
      <h2 class="mk-section-title mk-heading-line">{{ section.settings.heading }}</h2>
      <p class="mk-copy">{{ section.settings.text }}</p>
      <div class="mk-showroom__meta">
        <span>⌖ {{ section.settings.address }}</span>
        <span>◷ {{ section.settings.hours }}</span>
      </div>
      {% if section.settings.button_label != blank %}<p><a class="mk-button" href="{{ section.settings.button_link | default: '#' }}">{{ section.settings.button_label }}</a></p>{% endif %}
    </div>
    <a class="mk-map" href="{{ section.settings.map_link | default: '#' }}" aria-label="Open map for {{ section.settings.address }}">
      {% if section.settings.map_image != blank %}
        {{ section.settings.map_image | image_url: width: 1400 | image_tag: widths: '700, 1000, 1400', loading: 'lazy', alt: section.settings.address }}
      {% else %}
        <div class="mk-map__pin"><span><i>●</i></span><strong>{{ section.settings.map_label }}</strong><small>{{ section.settings.address }}</small></div>
      {% endif %}
    </a>
  </div>
</section>

{% schema %}
{
  "name": "Maliki showroom",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Visit Our Showroom" },
    { "type": "textarea", "id": "text", "label": "Text", "default": "Experience our majlis sets and Arabic heritage collections in person. We’d love to welcome you!" },
    { "type": "text", "id": "address", "label": "Address", "default": "6th of October City, Giza Governorate" },
    { "type": "text", "id": "hours", "label": "Hours", "default": "Sun – Thu · 9:00 AM – 8:00 PM" },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Get Directions" },
    { "type": "url", "id": "button_link", "label": "Button link" },
    { "type": "image_picker", "id": "map_image", "label": "Map image" },
    { "type": "text", "id": "map_label", "label": "Map label", "default": "Maliki Arabic" },
    { "type": "url", "id": "map_link", "label": "Map link" },
    { "type": "select", "id": "direction", "label": "Text direction", "default": "ltr", "options": [
      { "value": "ltr", "label": "Left to right" }, { "value": "rtl", "label": "Right to left" }
    ] }
  ],
  "presets": [{ "name": "Maliki showroom" }]
}
{% endschema %}
