<section class="mk-section mk-paper mk-moments" dir="{{ section.settings.direction }}">
  <div class="mk-wrap">
    <div class="mk-section-heading">
      <div>
        <p class="mk-kicker">{{ section.settings.eyebrow }}</p>
        <h2 class="mk-section-title mk-heading-line">{{ section.settings.heading }}</h2>
      </div>
      {% if section.settings.link_label != blank %}<a href="{{ section.settings.link | default: '#' }}">{{ section.settings.link_label }} →</a>{% endif %}
    </div>
    <div class="mk-moment-grid">
      {% for block in section.blocks %}
        <article class="mk-moment" {{ block.shopify_attributes }}>
          {% if block.settings.image != blank %}
            {{ block.settings.image | image_url: width: 700 | image_tag: widths: '280, 480, 700', loading: 'lazy', alt: block.settings.title }}
          {% else %}
            {% capture fallback %}maliki-social-{{ forloop.index }}.jpg{% endcapture %}
            <img src="{{ fallback | asset_url }}" width="420" height="240" loading="lazy" alt="{{ block.settings.title | escape }}">
          {% endif %}
          <h3>{{ block.settings.title }}</h3>
          <p>{{ block.settings.text }}</p>
        </article>
      {% endfor %}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Maliki moments",
  "tag": "section",
  "max_blocks": 4,
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "A tradition in every set" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Real Moments, Real Stories" },
    { "type": "text", "id": "link_label", "label": "Link label", "default": "Discover our story" },
    { "type": "url", "id": "link", "label": "Link" },
    { "type": "select", "id": "direction", "label": "Text direction", "default": "ltr", "options": [
      { "value": "ltr", "label": "Left to right" }, { "value": "rtl", "label": "Right to left" }
    ] }
  ],
  "blocks": [
    {
      "type": "moment",
      "name": "Moment",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Image" },
        { "type": "text", "id": "title", "label": "Title", "default": "At Home" },
        { "type": "text", "id": "text", "label": "Text", "default": "Bringing family closer" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Maliki moments",
      "blocks": [
        { "type": "moment", "settings": { "title": "At Home", "text": "Bringing family closer" } },
        { "type": "moment", "settings": { "title": "In the Desert", "text": "Tradition wherever you go" } },
        { "type": "moment", "settings": { "title": "With Friends", "text": "Creating lasting memories" } },
        { "type": "moment", "settings": { "title": "Our Heritage", "text": "A legacy for future generations" } }
      ]
    }
  ]
}
{% endschema %}
