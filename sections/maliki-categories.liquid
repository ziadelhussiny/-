<section class="mk-section mk-paper mk-categories" dir="{{ section.settings.direction }}">
  <div class="mk-wrap">
    <div class="mk-section-heading">
      <div><p class="mk-kicker">{{ section.settings.eyebrow }}</p><h2 class="mk-section-title">{{ section.settings.heading }}</h2></div>
      {% if section.settings.view_all_label != blank %}<a href="{{ section.settings.view_all_link | default: routes.collections_url }}">{{ section.settings.view_all_label }}</a>{% endif %}
    </div>
    <maliki-carousel class="mk-carousel">
      <button class="mk-scroll-button mk-scroll-button--prev" type="button" data-mk-scroll="-1" aria-label="Previous">‹</button>
      <div class="mk-category-track" data-mk-track>
        {% for block in section.blocks %}
          <a class="mk-category" href="{{ block.settings.link | default: routes.collections_url }}" {{ block.shopify_attributes }}>
            <div class="mk-category__media">
              {% if block.settings.image != blank %}
                {{ block.settings.image | image_url: width: 600 | image_tag: widths: '220, 360, 600', loading: 'lazy', alt: block.settings.title }}
              {% else %}
                {% case forloop.index %}
                  {% when 1 %}{% assign fallback = 'maliki-catalog-seating.png' %}
                  {% when 2 %}{% assign fallback = 'maliki-catalog-tent.png' %}
                  {% when 3 %}{% assign fallback = 'maliki-catalog-rugs.png' %}
                  {% when 4 %}{% assign fallback = 'maliki-catalog-storage.png' %}
                  {% else %}{% assign fallback = 'maliki-catalog-accessories.png' %}
                {% endcase %}
                <img src="{{ fallback | asset_url }}" width="1536" height="1024" loading="lazy" alt="{{ block.settings.title | escape }}">
              {% endif %}
            </div>
            <div class="mk-category__copy"><p class="mk-category__title">{{ block.settings.title }}</p>{% if block.settings.subtitle != blank %}<small>{{ block.settings.subtitle }}</small>{% endif %}<span aria-hidden="true">→</span></div>
          </a>
        {% endfor %}
      </div>
      <button class="mk-scroll-button mk-scroll-button--next" type="button" data-mk-scroll="1" aria-label="Next">›</button>
    </maliki-carousel>
  </div>
</section>

{% schema %}
{
  "name": "Maliki categories",
  "tag": "section",
  "max_blocks": 10,
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Shop by category" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Shop by category" },
    { "type": "text", "id": "view_all_label", "label": "View all label", "default": "View all" },
    { "type": "url", "id": "view_all_link", "label": "View all link" },
    { "type": "select", "id": "direction", "label": "Text direction", "default": "ltr", "options": [
      { "value": "ltr", "label": "Left to right" },
      { "value": "rtl", "label": "Right to left" }
    ] }
  ],
  "blocks": [
    {
      "type": "category",
      "name": "Category",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Image" },
        { "type": "text", "id": "title", "label": "Title", "default": "Majlis seating" },
        { "type": "text", "id": "subtitle", "label": "Subtitle", "default": "From EGP 450" },
        { "type": "url", "id": "link", "label": "Link" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Maliki categories",
      "blocks": [
        { "type": "category", "settings": { "title": "Outdoor Majlis" } },
        { "type": "category", "settings": { "title": "Tents" } },
        { "type": "category", "settings": { "title": "Rugs & Mats" } },
        { "type": "category", "settings": { "title": "Storage Bags" } },
        { "type": "category", "settings": { "title": "Accessories" } }
      ]
    }
  ]
}
{% endschema %}
