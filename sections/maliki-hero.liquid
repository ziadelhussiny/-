{% liquid
  assign hero_alt = section.settings.image.alt | default: section.settings.heading
%}

<section class="mk-section mk-hero mk-hero--{{ template.name | handle }}" dir="{{ section.settings.direction }}" style="--mk-hero-height: {{ section.settings.height }}px; --mk-focus: {{ section.settings.image_position }}; --mk-overlay: {{ section.settings.overlay_strength | divided_by: 100.0 }};">
  <picture>
    {% if section.settings.mobile_image != blank %}<source media="(max-width: 639px)" srcset="{{ section.settings.mobile_image | image_url: width: 900 }}">{% endif %}
    {% if section.settings.image != blank %}
      {{ section.settings.image | image_url: width: 2400 | image_tag: class: 'mk-hero__media', widths: '750, 1200, 1800, 2400', sizes: '100vw', loading: 'eager', fetchpriority: 'high', alt: hero_alt }}
    {% else %}
      <img class="mk-hero__media" src="{{ 'maliki-hero.png' | asset_url }}" width="1672" height="941" loading="eager" fetchpriority="high" alt="{{ hero_alt | escape }}">
    {% endif %}
  </picture>
  <div class="mk-hero__content"><div class="mk-hero__content-inner">
    {% if section.settings.eyebrow != blank %}<p class="mk-kicker mk-hero__eyebrow">{{ section.settings.eyebrow }}</p>{% endif %}
    {% if section.settings.heading != blank %}<h1 class="mk-title">{{ section.settings.heading | newline_to_br }}</h1>{% endif %}
    {% if section.settings.copy != blank %}<div class="mk-hero__copy">{{ section.settings.copy }}</div>{% endif %}
    {% if section.settings.button_label != blank or section.settings.secondary_button_label != blank %}<div class="mk-hero__ctas">
      {% if section.settings.button_label != blank %}<a class="mk-button {% if section.settings.button_style == 'gold' %}mk-button--gold{% endif %}" href="{{ section.settings.button_link | default: routes.all_products_collection_url }}">{{ section.settings.button_label }}</a>{% endif %}
      {% if section.settings.secondary_button_label != blank %}<a class="mk-button mk-button--outline" href="{{ section.settings.secondary_button_link | default: routes.collections_url }}">{{ section.settings.secondary_button_label }}</a>{% endif %}
    </div>{% endif %}
    {% if section.settings.show_stats and section.blocks.size > 0 %}<div class="mk-hero__stats" aria-label="Store highlights">{% for block in section.blocks %}<div class="mk-hero__stat" {{ block.shopify_attributes }}><strong>{{ block.settings.value }}</strong><span>{{ block.settings.label }}</span></div>{% endfor %}</div>{% endif %}
  </div></div>
  {% if section.settings.show_dots %}<div class="mk-hero__dots" aria-hidden="true"><i class="mk-hero__dot"></i><i class="mk-hero__dot"></i><i class="mk-hero__dot"></i></div>{% endif %}
</section>

{% schema %}
{
  "name": "Maliki hero",
  "tag": "section",
  "max_blocks": 4,
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Desktop image" },
    { "type": "image_picker", "id": "mobile_image", "label": "Mobile image" },
    { "type": "select", "id": "image_position", "label": "Image focus", "default": "center", "options": [{ "value": "left center", "label": "Left" }, { "value": "center", "label": "Center" }, { "value": "right center", "label": "Right" }] },
    { "type": "select", "id": "direction", "label": "Text direction", "default": "ltr", "options": [{ "value": "ltr", "label": "Left to right" }, { "value": "rtl", "label": "Right to left" }] },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Authentic Arabian gatherings" },
    { "type": "textarea", "id": "heading", "label": "Heading", "default": "Heritage You Can Carry.\nComfort Everywhere." },
    { "type": "richtext", "id": "copy", "label": "Text", "default": "<p>Premium portable majlis seating, heritage tents and desert essentials — crafted for journeys, gatherings and the moments in between.</p>" },
    { "type": "text", "id": "button_label", "label": "Primary button label", "default": "Shop Best Sellers" },
    { "type": "url", "id": "button_link", "label": "Primary button link" },
    { "type": "text", "id": "secondary_button_label", "label": "Secondary button label", "default": "Explore Heritage Tents" },
    { "type": "url", "id": "secondary_button_link", "label": "Secondary button link" },
    { "type": "select", "id": "button_style", "label": "Primary button style", "default": "gold", "options": [{ "value": "red", "label": "Heritage red" }, { "value": "gold", "label": "Gold" }] },
    { "type": "range", "id": "height", "label": "Desktop height", "min": 320, "max": 760, "step": 10, "unit": "px", "default": 610 },
    { "type": "range", "id": "overlay_strength", "label": "Overlay strength", "min": 20, "max": 90, "step": 5, "unit": "%", "default": 70 },
    { "type": "checkbox", "id": "show_stats", "label": "Show trust statistics", "default": true },
    { "type": "checkbox", "id": "show_dots", "label": "Show slider dots", "default": false }
  ],
  "blocks": [{ "type": "stat", "name": "Trust statistic", "settings": [{ "type": "text", "id": "value", "label": "Value", "default": "4.9★" }, { "type": "text", "id": "label", "label": "Label", "default": "Verified reviews" }] }],
  "presets": [{ "name": "Maliki hero", "blocks": [{ "type": "stat", "settings": { "value": "4.9★", "label": "Verified reviews" } }, { "type": "stat", "settings": { "value": "5,000+", "label": "Journeys equipped" } }, { "type": "stat", "settings": { "value": "14D", "label": "Easy returns" } }] }]
}
{% endschema %}
