{% liquid
  assign collection_url = section.settings.collection.url | default: section.settings.view_all_link | default: routes.all_products_collection_url
%}

<section class="mk-section mk-paper mk-products" dir="{{ section.settings.direction }}">
  <div class="mk-wrap">
    <div class="mk-section-heading">
      <div><p class="mk-kicker">{{ section.settings.eyebrow }}</p><h2 class="mk-section-title">{{ section.settings.heading }}</h2></div>
      {% if section.settings.view_all_label != blank %}<a href="{{ collection_url }}">{{ section.settings.view_all_label }}</a>{% endif %}
    </div>
    <maliki-carousel class="mk-carousel mk-products__carousel">
      <button class="mk-scroll-button mk-scroll-button--prev mk-scroll-button--mobile" type="button" data-mk-scroll="-1" aria-label="Previous products">‹</button>
      <div class="mk-product-grid" data-mk-track>
      {% for block in section.blocks %}
        {% liquid
          assign card_product = block.settings.product
          assign card_title = block.settings.title
          assign card_price = block.settings.price
          assign card_url = block.settings.link | default: collection_url
          if card_product != blank
            assign card_title = card_product.title
            assign card_price = card_product.price | money
            assign card_url = card_product.url
          endif
        %}
        <a class="mk-product-card" href="{{ card_url }}" {{ block.shopify_attributes }}>
          <div class="mk-product-card__media">
            {% if card_product.featured_image != blank %}
              {{ card_product.featured_image | image_url: width: 700 | image_tag: widths: '280, 480, 700', loading: 'lazy', alt: card_title }}
            {% elsif block.settings.image != blank %}
              {{ block.settings.image | image_url: width: 700 | image_tag: widths: '280, 480, 700', loading: 'lazy', alt: card_title }}
            {% else %}
              {% case forloop.index %}
                {% when 1 %}{% assign fallback = 'maliki-catalog-seating.png' %}
                {% when 2 %}{% assign fallback = 'maliki-catalog-seating.png' %}
                {% when 3 %}{% assign fallback = 'maliki-catalog-rugs.png' %}
                {% else %}{% assign fallback = 'maliki-catalog-storage.png' %}
              {% endcase %}
              <img src="{{ fallback | asset_url }}" width="1536" height="1024" loading="lazy" alt="{{ card_title | escape }}">
            {% endif %}
            <span class="mk-product-card__quick">Quick Add</span>
          </div>
          {% if block.settings.badge != blank %}<span class="mk-product-card__badge">{{ block.settings.badge }}</span>{% endif %}
          {% if section.settings.show_heart %}<span class="mk-product-card__heart" aria-hidden="true">♡</span>{% endif %}
          <p class="mk-product-card__rating"><span aria-hidden="true">★★★★★</span> {{ block.settings.rating }} ({{ block.settings.review_count }})</p>
          <p class="mk-product-card__name">{{ card_title }}</p>
          <div class="mk-product-card__bottom"><span>{{ card_price }}{% if block.settings.compare_price != blank %} <s>{{ block.settings.compare_price }}</s>{% endif %}</span>{% if block.settings.saving != blank %}<small>{{ block.settings.saving }}</small>{% endif %}</div>
        </a>
      {% endfor %}
      </div>
      <button class="mk-scroll-button mk-scroll-button--next mk-scroll-button--mobile" type="button" data-mk-scroll="1" aria-label="Next products">›</button>
    </maliki-carousel>
  </div>
</section>

{% schema %}
{
  "name": "Maliki products",
  "tag": "section",
  "max_blocks": 8,
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Loved by travellers" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Best sellers" },
    { "type": "text", "id": "view_all_label", "label": "View all label", "default": "View all" },
    { "type": "collection", "id": "collection", "label": "Shopify collection" },
    { "type": "url", "id": "view_all_link", "label": "View all link" },
    { "type": "checkbox", "id": "show_heart", "label": "Show wishlist icon", "default": true },
    { "type": "select", "id": "direction", "label": "Text direction", "default": "ltr", "options": [
      { "value": "ltr", "label": "Left to right" },
      { "value": "rtl", "label": "Right to left" }
    ] }
  ],
  "blocks": [
    {
      "type": "product",
      "name": "Product card",
      "settings": [
        { "type": "product", "id": "product", "label": "Shopify product" },
        { "type": "image_picker", "id": "image", "label": "Fallback image" },
        { "type": "text", "id": "title", "label": "Fallback title", "default": "Complete majlis seating" },
        { "type": "text", "id": "price", "label": "Fallback price", "default": "EGP 2,450" },
        { "type": "text", "id": "compare_price", "label": "Compare-at price" },
        { "type": "text", "id": "saving", "label": "Saving label" },
        { "type": "text", "id": "badge", "label": "Badge" },
        { "type": "text", "id": "rating", "label": "Rating", "default": "4.9" },
        { "type": "text", "id": "review_count", "label": "Review count", "default": "87" },
        { "type": "url", "id": "link", "label": "Fallback link" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Maliki products",
      "blocks": [
        { "type": "product", "settings": { "title": "Complete Outdoor Majlis Set", "price": "EGP 2,450" } },
        { "type": "product", "settings": { "title": "Large Storage Bag", "price": "EGP 950" } },
        { "type": "product", "settings": { "title": "Premium Round Outdoor Mat", "price": "EGP 1,750" } },
        { "type": "product", "settings": { "title": "Portable Majlis Set", "price": "EGP 1,950" } }
      ]
    }
  ]
}
{% endschema %}
