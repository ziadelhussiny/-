<section class="mk-section mk-seasonal" dir="{{ section.settings.direction }}">
  <div class="mk-wrap mk-seasonal__inner">
    <div class="mk-seasonal__copy">
      <p class="mk-kicker">{{ section.settings.eyebrow }}</p>
      <h2>{{ section.settings.heading }}</h2>
      <p>{{ section.settings.text }}</p>
    </div>
    {% if section.settings.show_timer %}
      <div class="mk-seasonal__timer" aria-label="Offer countdown">
        <span><strong>{{ section.settings.days }}</strong><small>Days</small></span>
        <span><strong>{{ section.settings.hours }}</strong><small>Hrs</small></span>
        <span><strong>{{ section.settings.minutes }}</strong><small>Min</small></span>
        <span><strong>{{ section.settings.seconds }}</strong><small>Sec</small></span>
      </div>
    {% endif %}
    {% if section.settings.button_label != blank %}<a class="mk-button mk-button--gold" href="{{ section.settings.button_link | default: routes.all_products_collection_url }}">{{ section.settings.button_label }}</a>{% endif %}
  </div>
</section>

{% schema %}
{
  "name": "Maliki seasonal offer",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Limited offer" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Heritage Tent of the Season" },
    { "type": "text", "id": "text", "label": "Text", "default": "The Arabic majlis tent — now 50% off. Limited stock, endless gatherings." },
    { "type": "checkbox", "id": "show_timer", "label": "Show countdown", "default": true },
    { "type": "text", "id": "days", "label": "Days", "default": "02" },
    { "type": "text", "id": "hours", "label": "Hours", "default": "14" },
    { "type": "text", "id": "minutes", "label": "Minutes", "default": "36" },
    { "type": "text", "id": "seconds", "label": "Seconds", "default": "22" },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Grab the Deal" },
    { "type": "url", "id": "button_link", "label": "Button link" },
    { "type": "select", "id": "direction", "label": "Text direction", "default": "ltr", "options": [{ "value": "ltr", "label": "Left to right" }, { "value": "rtl", "label": "Right to left" }] }
  ],
  "presets": [{ "name": "Maliki seasonal offer" }]
}
{% endschema %}
