<section class="mk-section mk-paper mk-testimonials" dir="{{ section.settings.direction }}">
  <div class="mk-wrap">
    <div class="mk-section-heading mk-section-heading--center"><div><p class="mk-kicker">{{ section.settings.eyebrow }}</p><h2 class="mk-section-title">{{ section.settings.heading }}</h2></div></div>
    <maliki-carousel class="mk-carousel mk-testimonials__carousel">
      <button class="mk-scroll-button mk-scroll-button--prev mk-scroll-button--mobile" type="button" data-mk-scroll="-1" aria-label="Previous reviews">‹</button>
      <div class="mk-testimonial-grid" data-mk-track>
        {% for block in section.blocks %}
          <article class="mk-quote" {{ block.shopify_attributes }}>
            <div class="mk-stars" aria-label="{{ block.settings.rating }} out of 5 stars">{% for i in (1..block.settings.rating) %}★{% endfor %}</div>
            <blockquote>“{{ block.settings.quote }}”</blockquote>
            <footer><span class="mk-quote__avatar">{{ block.settings.initials }}</span><cite><strong>{{ block.settings.author }}</strong><small>{{ block.settings.location }}</small></cite>{% if block.settings.verified %}<em>✓ Verified</em>{% endif %}</footer>
          </article>
        {% endfor %}
      </div>
      <button class="mk-scroll-button mk-scroll-button--next mk-scroll-button--mobile" type="button" data-mk-scroll="1" aria-label="Next reviews">›</button>
    </maliki-carousel>
  </div>
</section>

{% schema %}
{
  "name": "Maliki testimonials",
  "tag": "section",
  "max_blocks": 6,
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "What our customers say" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "What our customers say" },
    { "type": "select", "id": "direction", "label": "Text direction", "default": "ltr", "options": [
      { "value": "ltr", "label": "Left to right" },
      { "value": "rtl", "label": "Right to left" }
    ] }
  ],
  "blocks": [
    {
      "type": "testimonial",
      "name": "Testimonial",
      "settings": [
        { "type": "range", "id": "rating", "label": "Rating", "min": 1, "max": 5, "step": 1, "default": 5 },
        { "type": "textarea", "id": "quote", "label": "Quote", "default": "Beautiful authentic design and excellent quality." },
        { "type": "text", "id": "initials", "label": "Initials", "default": "SA" },
        { "type": "text", "id": "author", "label": "Author", "default": "Verified customer" },
        { "type": "text", "id": "location", "label": "Location", "default": "Cairo" },
        { "type": "checkbox", "id": "verified", "label": "Verified purchase", "default": true }
      ]
    }
  ],
  "presets": [
    {
      "name": "Maliki testimonials",
      "blocks": [
        { "type": "testimonial", "settings": { "quote": "Beautiful designs and truly authentic heritage fabrics.", "author": "Khaled, Giza" } },
        { "type": "testimonial", "settings": { "quote": "Practical, beautiful products that are perfect for every trip.", "author": "Sara, Alexandria" } },
        { "type": "testimonial", "settings": { "quote": "Excellent quality and impressively fast delivery.", "author": "Ahmed, Cairo" } }
      ]
    }
  ]
}
{% endschema %}
